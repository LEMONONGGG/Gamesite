    <h2>Flappy Bird</h2>
    <p>Tap to fly and dodge the pipes!</p>
  </a>

  <!-- Dino Run -->
  <a class="game-card" href="trex/index.html" data-category="arcade">
    <img src="https://via.placeholder.com/250x140?text=Dino+Run" alt="Dino Run


    }

